#!/bin/sh
# f1emu: adds the pretend modem to NetworkManager's device lists; everything
# else, Wi-Fi included, goes to the real nmcli untouched.
case "$*" in
  "-t -f DEVICE,TYPE device")
    /usr/bin/nmcli "$@"; echo "cdc-wdm0:gsm";;
  "-t -f DEVICE,TYPE,STATE,CONNECTION,IP4-CONNECTIVITY,IP6-CONNECTIVITY device")
    /usr/bin/nmcli "$@"; echo "cdc-wdm0:gsm:connected:Test Network:full:none";;
  *) exec /usr/bin/nmcli "$@";;
esac
