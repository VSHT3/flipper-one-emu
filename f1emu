class Fail(Exception):
    pass


def notify(msg):
    """Desktop notification when started from a launcher, where nobody sees the terminal."""
    if not sys.stdout.isatty() and shutil.which("notify-send"):
        subprocess.run(["notify-send", "-a", "Flipper One Emulator", "Flipper One Emulator", msg], check=False)


def say(msg):
    print(f"==> {msg}", flush=True)


def warn(msg):
    print(f"!!  {msg}", file=sys.stderr, flush=True)


def run(cmd, **kw):
    kw.setdefault("check", True)
    kw.setdefault("capture_output", True)
    kw.setdefault("text", True)
    try:
        return subprocess.run([str(c) for c in cmd], **kw)
    except subprocess.CalledProcessError as e:
        raise Fail(f"{cmd[0]} failed: {(e.stderr or e.stdout or '').strip()[-600:]}") from e


def need(*tools):
    missing = [t for t in tools if not shutil.which(t)]
    if missing:
        raise Fail("missing on this system: " + "; ".join(f"{t} (package {TOOLS[t]})" for t in missing))


def settings():
    conf = dict(DEFAULTS)
    if CONFIG.exists():
        loaded = tomllib.loads(CONFIG.read_text())
        unknown = set(loaded) - set(DEFAULTS) - {"build"}
        if unknown:
            raise Fail(f"{CONFIG}: unknown keys {sorted(unknown)}")
        conf.update(loaded)
    return conf


def http(url, data=None, timeout=10):
    req = urllib.request.Request(url, headers={"User-Agent": f"f1emu/{VERSION}"})
    if data is not None:
        req.data = json.dumps(data).encode()
        req.add_header("Content-Type", "application/json")
    with urllib.request.urlopen(req, timeout=timeout) as res:
        return res.read()


# ---------- images ----------

def remote_builds(include_branches=False):
    listing = json.loads(http(IMAGE_BASE + "manifest.json", timeout=30))
    out = []
    for d in listing["directories"]:
        name = d["name"].rstrip("/")
        if include_branches or name.isdigit():
            out.append((int(re.match(r"\d+", name).group()), name, d["mtime"]))
    return sorted(out)


def build_manifest(name):
    try:
        return json.loads(http(f"{IMAGE_BASE}{name}/manifest.json", timeout=30))
    except urllib.error.HTTPError as e:
        raise Fail(f"build {name} is not on the server (HTTP {e.code}); see `f1emu builds --remote`") from e


def local_builds():
    found = []
    for meta in sorted(BUILDS.glob("*/meta.json")):
        found.append(json.loads(meta.read_text()) | {"dir": str(meta.parent)})
    return sorted(found, key=lambda m: (m["number"], m["variant"]))


def download(url, dest, size, sha256):
    part = dest.with_name(dest.name + ".part")
    have = part.stat().st_size if part.exists() else 0
    if have > size:
        part.unlink()
        have = 0
    digest = hashlib.sha256()
    if have:
        with open(part, "rb") as f:
            while chunk := f.read(1 << 20):
                digest.update(chunk)
    if have < size:
        req = urllib.request.Request(url, headers={"Range": f"bytes={have}-", "User-Agent": f"f1emu/{VERSION}"})
        started = time.monotonic()
        with urllib.request.urlopen(req, timeout=60) as res, open(part, "ab") as f:
            if have and res.status != 206:
                raise Fail("the server ignored the resume request; delete the .part file and retry")
            shown = 0
            while chunk := res.read(1 << 20):
                f.write(chunk)
                digest.update(chunk)
                have += len(chunk)
                if time.monotonic() - shown > 0.5:
                    shown = time.monotonic()
                    rate = have / max(shown - started, 0.1) / 1e6
                    print(f"\r    {have / 1e6:7.0f} / {size / 1e6:.0f} MB  ({rate:.0f} MB/s)", end="", flush=True)
        print()
    if digest.hexdigest() != sha256:
        part.unlink()
        raise Fail("download is corrupt (SHA-256 mismatch); it was deleted, run the command again")
    part.rename(dest)


def root_partition(head):
    """Find the root partition in a GPT read from the start of the image."""
    if head[512:520] != b"EFI PART":
        raise Fail("the image has no GPT partition table")
    entries_lba, = struct.unpack_from("<Q", head, 512 + 72)
    count, entry_size = struct.unpack_from("<II", head, 512 + 80)
    best = None
    for i in range(count):
        entry = head[entries_lba * 512 + i * entry_size:][:entry_size]
        first, last = struct.unpack_from("<QQ", entry, 32)
        if not any(entry[:16]):
            continue
        name = entry[56:128].decode("utf-16le").rstrip("\0")
        candidate = (name == "root", last - first, first * 512, (last - first + 1) * 512)
        best = max(best, candidate) if best else candidate
    if not best:
        raise Fail("the image has no partitions")
    return best[2], best[3]


def unpack_root(zst, dest):
    """Decompress the image and keep only its root partition, sparse, in one pass."""
    need("zstd")
    proc = subprocess.Popen(["zstd", "-dc", "-T0", str(zst)], stdout=subprocess.PIPE)
    try:
        head = proc.stdout.read(1 << 20)
        offset, size = root_partition(head)
        skip = offset - len(head)
        if skip < 0:
            raise Fail("unexpected partition layout in the image")
        while skip:
            skip -= len(proc.stdout.read(min(skip, 1 << 20)) or b"") or (_ for _ in ()).throw(Fail("image is truncated"))
        zeros = bytes(1 << 20)
        left = size
        with open(dest, "wb") as out:
            while left:
                chunk = proc.stdout.read(min(left, 1 << 20))
                if not chunk:
                    raise Fail("image is truncated")
                left -= len(chunk)
                if chunk == zeros[:len(chunk)]:
                    out.seek(len(chunk), os.SEEK_CUR)
                else:
                    out.write(chunk)
            out.truncate(size)
    finally:
        proc.kill()
        proc.wait()


def inspect_root(root, build_dir):
    """Read the profile list and boot entries straight from the btrfs image."""
    need("btrfs")
    fsid = re.search(r"^fsid\s+(\S+)", run(["btrfs", "inspect-internal", "dump-super", root]).stdout, re.M).group(1)
    tree = run(["btrfs", "inspect-internal", "dump-tree", "-t", "root", root]).stdout
    subvols = {name: int(sid) for sid, name in re.findall(r"\(FS_TREE ROOT_REF (\d+)\).*\n.*\bname (\S+)", tree)}
    if "boot" not in subvols:
        raise Fail("this image has no boot subvolume; its layout is not supported")
    entries = []
    with tempfile.TemporaryDirectory(dir=build_dir) as tmp:
        run(["btrfs", "restore", "-r", subvols["boot"], root, tmp])
        for conf in sorted(Path(tmp).glob("loader/entries/*.conf")):
            fields = dict(line.split(None, 1) for line in conf.read_text().splitlines() if line and not line.startswith("#"))
            m = re.match(r"/(@[^/]+)(/.+)", fields.get("linux", ""))
            if not m or m.group(1) not in subvols:
                continue
            version = fields["version"]
            config = Path(tmp) / f"config-{version}"
            entries.append({
                "profile": m.group(1)[1:],
                "version": version,
                "linux": m.group(2),
                "initrd": re.sub(r"^/@[^/]+", "", fields["initrd"]),
                # Without virtio-blk the kernel cannot see QEMU's disk at all.
                "bootable": config.exists() and bool(re.search(r"^CONFIG_VIRTIO_BLK=[ym]", config.read_text(), re.M)),
            })
    return {"fsid": fsid, "subvols": subvols, "entries": entries}


def fetch(number=None, variant=None, keep=False):
    conf = settings()
    variant = variant or conf["variant"]
    if number is None:
        number = conf.get("build")
    if number is None:
        say("Looking up the newest official build")
        number = remote_builds()[-1][1]
    number = str(number)
    build_dir = BUILDS / f"{number}-{variant}"
    if (build_dir / "meta.json").exists():
        return json.loads((build_dir / "meta.json").read_text()) | {"dir": str(build_dir)}
    need("zstd", "btrfs")
    manifest = build_manifest(number)
    files = {f["path"]: f for f in manifest["files"]}
    name = next((p for p in files if re.fullmatch(rf".*-{re.escape(variant)}-\d+\.img\.zst", p)), None)
    if not name:
        variants = sorted({m.group(1) for p in files if (m := re.fullmatch(r"debian-\d+-(.+)-\d+\.img\.zst", p))})
        raise Fail(f"build {number} has no '{variant}' image; available: {', '.join(variants)}")
    free = shutil.disk_usage(DATA if DATA.exists() else DATA.parent).free
    if free < 10e9:
        raise Fail(f"only {free / 1e9:.1f} GB free; about 10 GB are needed while setting up")
    build_dir.mkdir(parents=True, exist_ok=True)
    zst = build_dir / name
    if not zst.exists():
        say(f"Downloading Flipper OS build {number} ({variant}, {files[name]['size'] / 1e9:.1f} GB)")
        download(f"{IMAGE_BASE}{number}/{name}", zst, files[name]["size"], files[name]["sha256"])
    say("Unpacking the root filesystem")
    root = build_dir / "root.btrfs"
    unpack_root(zst, root)
    say("Reading profiles and kernels from the image")
    meta = inspect_root(root, build_dir) | {
        "number": int(re.match(r"\d+", number).group()),
        "name": number,
        "variant": variant,
        "sha256": files[name]["sha256"],
        "built": manifest["build"]["timestamp"],
    }
    if not any(e["bootable"] for e in meta["entries"]):
        shutil.rmtree(build_dir)
        raise Fail(f"build {number} has no kernel that can boot in QEMU")
    (build_dir / "meta.json").write_text(json.dumps(meta, indent=1))
    if not keep:
        zst.unlink()
    return meta | {"dir": str(build_dir)}


def pick_entry(meta, profile, kernel):
    names = sorted({e["profile"] for e in meta["entries"]})
    wanted = [e for e in meta["entries"] if e["profile"].lower() == profile.lower()]
    if not wanted:
        raise Fail(f"build {meta['name']} has no profile '{profile}'; it has: {', '.join(names)}")
    if kernel:
        wanted = [e for e in wanted if kernel in e["version"]]
        if not wanted:
            raise Fail(f"profile {profile} has no kernel matching '{kernel}'")
    bootable = [e for e in wanted if e["bootable"]]
    if not bootable:
        raise Fail(f"kernel {wanted[0]['version']} has no virtio drivers, so it cannot boot in QEMU")
    return bootable[0]


def read_from_image(meta, profile, paths, tmp):
    """Copy single files out of one profile of the image into tmp, without mounting it."""
    need("btrfs")
    prefixes = {"/".join(p.split("/")[:i]) for p in paths for i in range(1, len(p.split("/")) + 1)}
    regex = "^(" + "|".join(sorted(re.escape(p) for p in prefixes | {"/"})) + ")$"
    run(["btrfs", "restore", "-r", meta["subvols"]["@" + profile], "--path-regex", regex,
         Path(meta["dir"]) / "root.btrfs", tmp])
    found = [Path(tmp + p) for p in paths]
    if not all(f.exists() for f in found):
        raise Fail(f"{', '.join(paths)} could not be read from the image")
    return found


def boot_files(meta, entry):
    """Kernel and initramfs for one boot entry, extracted on first use."""
    out = Path(meta["dir"]) / "boot" / entry["profile"] / entry["version"]
    if (out / "Image").exists() and (out / "initrd").exists():
        return out
    say(f"Extracting kernel {entry['version']} for profile {entry['profile']}")
    with tempfile.TemporaryDirectory(dir=meta["dir"]) as tmp:
        kernel, initrd = read_from_image(meta, entry["profile"], [entry["linux"], entry["initrd"]], tmp)
        out.mkdir(parents=True, exist_ok=True)
        data = kernel.read_bytes()
        # QEMU's EFI loader wants the bare Image; the OS ships it gzipped.
        (out / "Image").write_bytes(gzip.decompress(data) if data[:2] == b"\x1f\x8b" else data)
        shutil.copy(initrd, out / "initrd")
    return out


# ---------- instances ----------

class Instance:
    def __init__(self, name):
        if not re.fullmatch(r"[A-Za-z0-9_.-]+", name):
            raise Fail("instance names may only contain letters, digits, '_', '.' and '-'")
        self.name = name
        self.dir = INSTANCES / name
        self.disk = self.dir / "disk.qcow2"
        self.state_file = self.dir / "instance.json"
        self.pid_file = self.dir / "qemu.pid"
        self.qmp_sock = self.dir / "qmp.sock"
        self.console = self.dir / "console.log"
        self.qemu_log = self.dir / "qemu.log"

    @property
    def state(self):
        return json.loads(self.state_file.read_text()) if self.state_file.exists() else {}

    def save(self, **changes):
        self.dir.mkdir(parents=True, exist_ok=True)
        self.state_file.write_text(json.dumps(self.state | changes, indent=1))

    def pid(self):
        try:
            pid = int(self.pid_file.read_text())
            if "qemu-system-aarch64" in Path(f"/proc/{pid}/cmdline").read_bytes().decode(errors="replace"):
                return pid
        except (OSError, ValueError):
            pass
        return None

    def running(self):
        return self.pid() is not None

    def require_running(self):
        if not self.running():
            raise Fail(f"instance '{self.name}' is not running; start it with `f1emu start`")

    def url(self, path=""):
        """The device's own web server, as forwarded by QEMU: what the commands talk to."""
        return f"http://127.0.0.1:{self.state.get('guest_port', self.state['port'])}/{path}"

    def view_url(self, path=""):
        """The address a person opens: the view proxy, which sharpens the panel."""
        host = self.state["listen"]
        return f"http://{'127.0.0.1' if host == '0.0.0.0' else host}:{self.state['port']}/{path}"

    def qmp(self, command, **arguments):
        with socket.socket(socket.AF_UNIX) as s:
            s.settimeout(10)
            s.connect(str(self.qmp_sock))
            f = s.makefile("rw")
            f.readline()
            for msg in ({"execute": "qmp_capabilities"}, {"execute": command, "arguments": arguments}):
                f.write(json.dumps(msg) + "\n")
                f.flush()
                while "return" not in (reply := json.loads(f.readline())):
                    if "error" in reply:
                        raise Fail(f"QEMU refused {command}: {reply['error']['desc']}")
            return reply["return"]

    def ssh_base(self, tool="ssh", root=False):
        port_flag = "-P" if tool == "scp" else "-p"
        return [tool, "-i", str(SSH_KEY), port_flag, str(self.state["ssh_port"]),
                "-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null",
                "-o", "LogLevel=ERROR", "-o", "IdentitiesOnly=yes", "-o", "ConnectTimeout=10"], \
            f"{'root' if root else 'user'}@127.0.0.1"

    def ssh(self, command, root=False, timeout=30, check=True):
        base, target = self.ssh_base(root=root)
        return run(base + ["-o", "BatchMode=yes", "-o", "ConnectTimeout=5", target, command], timeout=timeout, check=check)


def all_instances():
    return [Instance(p.name) for p in sorted(INSTANCES.glob("*")) if (p / "instance.json").exists()]


def free_port(host, wanted, taken=()):
    for port in range(wanted, wanted + 200):
        if port in taken:
            continue
        with socket.socket() as s:
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            try:
                s.bind((host, port))
                return port
            except OSError:
                continue
    raise Fail(f"no free port near {wanted}")


def ssh_public_key():
    if not SSH_KEY.exists():
        need("ssh-keygen")
        SSH_KEY.parent.mkdir(parents=True, exist_ok=True)
        run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "f1emu", "-f", SSH_KEY])
    return SSH_KEY.with_suffix(".pub").read_text().strip()


def firmware_args():
    for path, mode in FIRMWARE:
        if os.path.exists(path):
            if mode == "bios":
                return ["-bios", path]
            return ["-drive", f"if=pflash,format=raw,readonly=on,file={path}"]
    raise Fail("no AArch64 UEFI firmware found (package edk2-aarch64, qemu-efi-aarch64 or edk2-aarch64 on Fedora)")


def credentials(pubkey):
    """Adapt the guest through systemd credentials, so the image itself stays untouched.

    The SSH key lets `f1emu ssh` in. The drop-in is what makes hosted apps work:
    QEMU has no Flipper panel, so seat1 never exists, the unit's login session is
    refused, and without a session there is no runtime directory for the
    compositor apps are drawn in. Dropping the seat gets a plain session; the
    rest selects software rendering, as there is no GPU either.

    On the kernel command line because this kernel has neither dmi-sysfs nor
    fw_cfg, the two channels systemd reads QEMU-supplied credentials from.
    """
    tmpfiles = (
        "d /home/user/.ssh 0700 user user -\n"
        f"f /home/user/.ssh/authorized_keys 0600 user user - {pubkey}\n"
    )
    creds = {
        "ssh.authorized_keys.root": pubkey.encode(),
        "tmpfiles.extra": tmpfiles.encode(),
        "systemd.unit-dropin.flipctl.service": (
            b"[Service]\nEnvironment=XDG_SEAT=\n"
            b"Environment=WLR_RENDERER=pixman FLIPCTL_NO_GPU=1 SDL_RENDER_DRIVER=software LIBGL_ALWAYS_SOFTWARE=1\n"
            # Where `f1emu sim` puts its stand-ins for mmcli and friends; empty otherwise.
            b"Environment=PATH=/run/f1emu/bin:/usr/local/bin:/usr/bin:/bin:/usr/games\n"),
    }
    return " ".join(f"systemd.set_credential_binary={name}:{base64.b64encode(value).decode()}"
                    for name, value in creds.items())


def qemu_command(inst, meta, entry, boot, opts):
    kvm = platform.machine() == "aarch64" and os.access("/dev/kvm", os.R_OK | os.W_OK)
    if kvm:
        machine = ["-M", "virt,acpi=off,gic-version=host", "-accel", "kvm", "-cpu", "host"]
    else:
        # Emulating pointer authentication is the single most expensive CPU feature
        # under TCG: with it off, boot went from 21 s to 17 s and a Python loop in
        # the guest from 7.7 s to 3.1 s on the machine this was measured on.
        machine = ["-M", "virt,acpi=off", "-accel", "tcg,thread=multi", "-cpu", "max,pauth=off"]
    # The Flipper kernel is device-tree only: with ACPI tables present it finds no
    # timer and panics, hence acpi=off. hvc0 is listed last so systemd logs there.
    append = (f"root=UUID={meta['fsid']} rootflags=subvol=@{entry['profile']} rw rootwait "
              f"console=tty0 console=hvc0 {credentials(ssh_public_key())} {opts['append']}").strip()
    forwards = [f"hostfwd=tcp:127.0.0.1:{opts['guest_port']}-:8899", f"hostfwd=tcp:127.0.0.1:{opts['ssh_port']}-:22"]
    for spec in opts["forward"]:
        m = re.fullmatch(r"(\d+):(\d+)(/udp)?", spec)
        if not m:
            raise Fail(f"--forward wants HOSTPORT:GUESTPORT[/udp], not '{spec}'")
        forwards.append(f"hostfwd={'udp' if m.group(3) else 'tcp'}:{opts['listen']}:{m.group(1)}-:{m.group(2)}")
    net = "user,id=net0," + ",".join(forwards) + ("" if opts["network"] else ",restrict=on")
    cmd = ["qemu-system-aarch64", "-name", f"flipper-one-{inst.name}", *machine,
           "-smp", str(opts["cpus"]), "-m", str(opts["memory"]),
           # Modern virtio: the display and input devices do not exist in the legacy flavour.
           "-global", "virtio-mmio.force-legacy=false",
           *firmware_args(), "-device", "ramfb",
           "-kernel", str(boot / "Image"), "-initrd", str(boot / "initrd"), "-append", append,
           "-drive", f"if=none,file={inst.disk},format=qcow2,id=hd0,discard=unmap",
           "-device", "virtio-blk-device,drive=hd0",
           "-netdev", net, "-device", "virtio-net-device,netdev=net0",
           "-device", "virtio-rng-device",
           "-device", "virtio-serial-device",
           "-chardev", f"file,id=con0,path={inst.console}", "-device", "virtconsole,chardev=con0",
           "-qmp", f"unix:{inst.qmp_sock},server=on,wait=off",
           "-pidfile", str(inst.pid_file)]
    if opts["ephemeral"]:
        cmd.append("-snapshot")
    display = opts["display"]
    if opts["video"]:
        # The stand-in for the HDMI port: a second screen, with a keyboard and a pointer.
        cmd += ["-device", "virtio-gpu-device,id=video0,xres=1280,yres=720",
                "-device", "virtio-keyboard-device", "-device", "virtio-tablet-device"]
        if display == "none" and "gtk" in run(["qemu-system-aarch64", "-display", "help"]).stdout:
            display = "gtk"
    cmd += ["-display", display] + opts["qemu_arg"]
    return cmd


def wait_ready(inst, proc, timeout):
    started = time.monotonic()
    shown = 0
    while (elapsed := time.monotonic() - started) < timeout:
        if proc.poll() is not None:
            raise Fail(f"QEMU exited (code {proc.returncode}):\n{inst.qemu_log.read_text()[-1500:]}")
        try:
            http(inst.url("apps.json"), timeout=3)
            print()
            return elapsed
        except (OSError, urllib.error.URLError):
            pass
        if elapsed - shown >= 1:
            shown = elapsed
            print(f"\r    waiting for Flipper OS ... {int(elapsed)}s", end="", flush=True)
        time.sleep(0.5)
    print()
    raise Fail(f"Flipper OS did not answer within {timeout}s. It is still running; see `f1emu log` "
               f"and `f1emu screenshot --vt boot.png`, or stop it with `f1emu stop --force`.")


def open_view(inst, how):
    url = inst.view_url()
    if how == "none":
        return
    if how == "app":
        for exe in ("chromium", "brave", "google-chrome-stable", "google-chrome", "vivaldi", "microsoft-edge"):
            if shutil.which(exe):
                subprocess.Popen([exe, f"--app={url}", "--window-size=1100,760"], start_new_session=True,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return
        warn("no Chromium-based browser found for --open app; using the default browser")
    if shutil.which("xdg-open"):
        subprocess.Popen(["xdg-open", url], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


AUDIO_CONF = """\
context.spa-libs = {{
    audio.convert.* = audioconvert/libspa-audioconvert
    support.*       = support/libspa-support
}}
context.modules = [
    {{ name = libpipewire-module-protocol-native }}
    {{ name = libpipewire-module-client-node }}
    {{ name = libpipewire-module-adapter }}
{tunnels}]
"""
AUDIO_TUNNEL = """\
    {{ name = libpipewire-module-pulse-tunnel
      args = {{ tunnel.mode = {mode} pulse.server.address = "tcp:10.0.2.2:{port}"
               stream.props = {{ node.name = "pc-{mode}" node.description = "{label}" }} }} }}
"""


def audio_off(inst):
    port = inst.state.get("audio_port")
    if port and shutil.which("pactl"):
        # Unload by what the module is, not by a remembered id: ids are reused
        # once the host's sound server restarts.
        for line in run(["pactl", "list", "modules", "short"], check=False).stdout.splitlines():
            if "module-native-protocol-tcp" in line and f"port={port} " in line + " ":
                run(["pactl", "unload-module", line.split()[0]], check=False)
    if port:
        inst.save(audio_port=None)


def audio_on(inst, mic):
    """Give the guest a sound card by tunnelling its PipeWire to the host's sound server.

    The kernel has no driver for any sound device QEMU can emulate, so the guest
    gets a network sink (and optionally a source) instead. 10.0.2.2 is the host
    as seen through QEMU's NAT; on the host side the port is loopback-only.
    """
    if not shutil.which("pactl"):
        raise Fail("pactl not found; sound needs PipeWire or PulseAudio on this PC")
    audio_off(inst)
    port = free_port("127.0.0.1", 4714)
    run(["pactl", "load-module", "module-native-protocol-tcp", "listen=127.0.0.1", f"port={port}",
         "auth-ip-acl=127.0.0.1"])
    inst.save(audio_port=port)
    tunnels = AUDIO_TUNNEL.format(mode="sink", port=port, label="PC speakers")
    if mic:
        tunnels += AUDIO_TUNNEL.format(mode="source", port=port, label="PC microphone")
    inst.ssh("systemctl --user stop f1emu-audio 2>/dev/null; systemctl --user reset-failed f1emu-audio 2>/dev/null; "
             f"cat > $XDG_RUNTIME_DIR/f1emu-audio.conf <<'EOF'\n{AUDIO_CONF.format(tunnels=tunnels)}EOF\n"
             "systemd-run --user --quiet --unit f1emu-audio pipewire -c $XDG_RUNTIME_DIR/f1emu-audio.conf")


def unmount_all(inst):
    for target in inst.state.get("mounts", []):
        tool = shutil.which("fusermount3") or shutil.which("fusermount")
        if tool and os.path.ismount(target):
            run([tool, "-u", "-z", target], check=False)
    inst.save(mounts=[])


def parse_size(text):
    m = re.fullmatch(r"(\d+)([GM])", text.upper())
    if not m:
        raise Fail("sizes look like 16G or 8192M")
    return int(m.group(1)) << (30 if m.group(2) == "G" else 20)


