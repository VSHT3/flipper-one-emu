SIM_DIR = Path(__file__).resolve().parent / "sim"
# What each simulator is made of: the kernel module that provides it.
SIM_MODULES = {"wifi": "mac80211_hwsim", "battery": "test_power", "modem": "wwan_hwsim", "laptop": "veth"}
VIDEO_MODULES = ("virtio_dma_buf", "virtio-gpu", "virtio_input")
SIM_DEFAULT = ("wifi", "battery", "modem")
USB_STATES = {
    # What is in USB-C1: (mains, usb, battery status, battery current in µA; negative drains).
    # The pack is two cells, 7.7 V nominal. Idle draw is the 0.96 W Flipper measured.
    "none": ("off", "off", "discharging", -125000),
    "charger": ("on", "on", "charging", 1000000),
    "device": ("off", "on", "discharging", -1200000),
}
SIM_STATE = r"""
p=/sys/module/test_power/parameters
echo eth0=$(cat /sys/class/net/eth0/carrier 2>/dev/null)
echo eth1=$(cat /sys/class/net/eth1/carrier 2>/dev/null)
echo wifi=$(cat /sys/class/net/wlan0/operstate 2>/dev/null)
echo level=$(cat $p/battery_capacity 2>/dev/null)
echo current=$(cat $p/battery_current 2>/dev/null)
echo voltage=$(cat $p/battery_voltage 2>/dev/null)
echo video=$(test -e /dev/dri/card0 && echo 1)
echo cable=$(cat /run/f1emu/cable 2>/dev/null)
echo signal=$(cat /run/f1emu/modem/signal 2>/dev/null)
echo online=$(/usr/bin/nmcli -t -f CONNECTIVITY general 2>/dev/null)
echo mods=$(lsmod | grep -oE '^(mac80211_hwsim|test_power|wwan_hwsim)' | tr '\n' ,)
"""


def sim_kinds(names):
    names = list(SIM_DEFAULT) if not names or "all" in names else names
    unknown = set(names) - set(SIM_MODULES)
    if unknown:
        raise Fail(f"unknown simulator {', '.join(sorted(unknown))}; there are: {', '.join(SIM_MODULES)}")
    return sorted(set(names))


def sim_modules(inst):
    """The extra kernel modules for this instance's kernel, built on first use.

    Flipper OS ships none of the kernel's test drivers. They are compiled from
    Flipper's public kernel source inside a throwaway instance of the same
    build, which has the exact compiler the kernel was built with.
    """
    state = inst.state
    out = BUILDS / f"{state['build']}-{state['variant']}" / "sim" / state["kernel"]
    if all((out / f"{m}.ko").exists() for m in (*SIM_MODULES.values(), *VIDEO_MODULES)):
        return out
    say(f"Building the hardware simulators for kernel {state['kernel']} (once per kernel, a few minutes)")
    me = [sys.executable, os.path.abspath(__file__)]
    builder = Instance("sim-builder")
    if builder.dir.exists():
        run(me + ["stop", "-n", builder.name, "--force"], check=False)
        shutil.rmtree(builder.dir)
    try:
        run(me + ["start", "-n", builder.name, "--build", state["build"], "--variant", state["variant"],
                  "--profile", state["profile"], "--kernel", state["kernel"], "--ephemeral", "--disk-size", "16G",
                  "--open", "none", "--no-audio", "--no-sim", "-m", "8192", "-c", str(min(16, os.cpu_count() or 1))])
        scp, target = builder.ssh_base("scp", root=True)
        run(scp + [SIM_DIR / "build.sh", f"{target}:/root/build.sh"])
        built = builder.ssh("bash /root/build.sh 2>&1", root=True, timeout=3600, check=False)
        if built.returncode:
            raise Fail("the simulators did not build:\n" + built.stdout[-1500:])
        out.mkdir(parents=True, exist_ok=True)
        run(scp + [f"{target}:/root/out/*.ko", out])
    finally:
        run(me + ["stop", "-n", builder.name, "--force"], check=False)
        shutil.rmtree(builder.dir, ignore_errors=True)
    return out


def sim_on(inst, kinds):
    """Load pretend hardware into a running guest. It lasts until the guest stops.

    Everything goes into a tmpfs of its own: /run is mounted noexec, and the
    modem stand-ins have to be executable.
    """
    modules = sim_modules(inst)
    inst.ssh("mountpoint -q /run/f1emu || { mkdir -p /run/f1emu && mount -t tmpfs -o exec,mode=755 tmpfs /run/f1emu; }; "
             "mkdir -p /run/f1emu/bin /run/f1emu/modem /run/f1emu/shims", root=True)
    scp, target = inst.ssh_base("scp", root=True)
    run(scp + [*(modules / f"{m}.ko" for m in SIM_MODULES.values()), SIM_DIR / "wifi.sh", SIM_DIR / "laptop.sh",
               f"{target}:/run/f1emu/"])
    run(scp + [*(SIM_DIR / name for name in ("mmcli", "qmicli", "nmcli")), f"{target}:/run/f1emu/shims/"])
    steps, restart = [], False
    loaded = inst.ssh("lsmod", root=True).stdout
    if "wifi" in kinds and "mac80211_hwsim" not in loaded:
        steps.append("sh /run/f1emu/wifi.sh")
        restart = True
    if "battery" in kinds and "test_power" not in loaded:
        steps.append("insmod /run/f1emu/test_power.ko battery_voltage=7700000 battery_current=-125000 && "
                     "echo discharging > /sys/module/test_power/parameters/battery_status && "
                     "echo off > /sys/module/test_power/parameters/ac_online && echo none > /run/f1emu/cable")
        restart = True
    if "modem" in kinds and "wwan_hwsim" not in loaded:
        steps.append("modprobe wwan && insmod /run/f1emu/wwan_hwsim.ko devices=1 && cp /run/f1emu/shims/* /run/f1emu/bin/")
        restart = True
    if "laptop" in kinds:
        steps.append("{ ip netns list | grep -q '^laptop' || sh /run/f1emu/laptop.sh up; }")
    if restart:
        # flipctl looks for hardware when it starts.
        steps.append("systemctl restart flipctl")
    if steps:
        done = inst.ssh("{ " + " && ".join(steps) + "; } 2>&1", root=True, timeout=180, check=False)
        if done.returncode:
            raise Fail(done.stdout.strip()[-600:])
    for _ in range(40 if restart else 0):
        try:
            http(inst.url("apps.json"), timeout=3)
            break
        except (OSError, urllib.error.URLError):
            time.sleep(0.5)
    say(f"Simulated hardware on: {', '.join(kinds)}")


def sim_state(inst):
    """What the pretend hardware is doing right now, read from the guest itself."""
    raw = dict(line.split("=", 1) for line in inst.ssh(SIM_STATE, root=True, timeout=15).stdout.splitlines() if "=" in line)
    watts = int(raw["current"] or 0) * int(raw["voltage"] or 0) / 1e12
    sim = [kind for kind, module in SIM_MODULES.items() if module in raw["mods"]]
    if raw["eth1"]:
        sim.append("laptop")
    return {
        "sim": sim,
        "eth0": raw["eth0"] == "1",
        "eth1": raw["eth1"] == "1",
        "wifi": raw["wifi"] or None,
        "online": raw["online"] == "full",
        "level": int(raw["level"]) if raw["level"] else None,
        "cable": raw["cable"] or "none",
        "signal": int(raw["signal"] or 74),
        "video": raw["video"] == "1",
        # Watts out of the battery, and watts coming in through USB-C1: what goes
        # into the battery plus the same idle draw the device needs for itself.
        "charging": watts > 0,
        "draw_w": round(max(0.0, -watts), 2),
        "input_w": round(watts + 0.96, 2) if raw["cable"] == "charger" else 0.0,
    }


def cmd_sim(a):
    inst = Instance(a.name)
    inst.require_running()
    first = a.values[0] if a.values else None
    if a.action == "on":
        sim_on(inst, sim_kinds(a.values))
    elif a.action == "battery":
        sets = []
        if first:
            if not first.isdigit() or not 0 <= int(first) <= 100:
                raise Fail("the battery level is a number from 0 to 100")
            sets.append(f"echo {first} > battery_capacity")
        if a.charging or a.discharging:
            sets.append(f"echo {'on' if a.charging else 'off'} > ac_online")
            sets.append(f"echo {'charging' if a.charging else 'discharging'} > battery_status")
        if not sets:
            raise Fail("give a level, --charging or --discharging")
        done = inst.ssh("cd /sys/module/test_power/parameters && " + " && ".join(sets), root=True, check=False)
        if done.returncode:
            raise Fail("the simulated battery is not loaded; run `f1emu sim on battery`")
        say("Battery set")
    elif a.action == "usb":
        if first not in USB_STATES:
            raise Fail(f"say what is plugged into USB-C: {', '.join(USB_STATES)}")
        mains, usb, status, current = USB_STATES[first]
        done = inst.ssh(f"cd /sys/module/test_power/parameters && echo {mains} > ac_online && echo {usb} > usb_online && "
                        f"echo {status} > battery_status && echo {current} > battery_current && "
                        f"echo {first} > /run/f1emu/cable", root=True, check=False)
        if done.returncode:
            raise Fail("the simulated battery is not loaded; run `f1emu sim on battery`")
        say({"none": "USB-C unplugged", "charger": "Charger plugged in", "device": "Flipper is powering a device"}[first])
    elif a.action == "laptop":
        if first == "on":
            sim_on(inst, ["laptop"])
        elif first == "off":
            inst.ssh("sh /run/f1emu/laptop.sh down", root=True, check=False)
            say("Laptop unplugged")
        elif first == "run" and a.values[1:]:
            base, target = inst.ssh_base(root=True)
            os.execvp("ssh", base + ["-t", target, "ip netns exec laptop " + shlex.join(a.values[1:])])
        else:
            raise Fail("use `sim laptop on`, `sim laptop off` or `sim laptop run COMMAND`")
    elif a.action == "pcap":
        if not first:
            raise Fail("name the file to save the capture to")
        done = inst.ssh("ip link set hwsim0 up && "
                        "{ ip netns exec f1phone wpa_cli -p /run/f1emu/phone -i wlan4 reassociate >/dev/null; "
                        f"timeout {a.seconds} tcpdump -q -i hwsim0 -w /run/f1emu/air.pcap 2>&1 | tail -1; }}",
                        root=True, timeout=a.seconds + 30, check=False)
        if done.returncode:
            raise Fail("the simulated Wi-Fi is not loaded; run `f1emu sim on wifi`")
        scp, target = inst.ssh_base("scp", root=True)
        run(scp + [f"{target}:/run/f1emu/air.pcap", first])
        say(f"Saved {first} ({os.path.getsize(first) // 1024} KB of simulated air, {a.seconds} s)")
    else:
        state = sim_state(inst)
        on = state["sim"]
        print(f"wifi     {'on, ' + (state['wifi'] or '') if 'wifi' in on else 'off'}")
        if "wifi" in on:
            print(inst.ssh("/usr/bin/nmcli -t -f SSID,SIGNAL,SECURITY device wifi list | sed 's/^/           /'",
                           root=True).stdout.rstrip())
        print(f"battery  {'on, %d%%, USB-C: %s' % (state['level'], state['cable']) if 'battery' in on else 'off'}")
        print(f"modem    {'on, signal %d%%' % state['signal'] if 'modem' in on else 'off'}")
        print(f"laptop   {'plugged into ETH1' if 'laptop' in on else 'off'}")


VIEW_ACTIONS = ("on", "battery", "modem", "usb", "laptop")


def cmd_viewer(a):
    """Internal: the view proxy. Passes everything to the device and adds f1emu's own layer."""
    inst = Instance(a.name)
    state = inst.state
    me = [sys.executable, os.path.abspath(__file__), "sim", "-n", inst.name]
    cache = {"at": 0.0, "body": b"{}"}
    lock = threading.Lock()

    def sim_json():
        with lock:
            if time.monotonic() - cache["at"] > 2:
                try:
                    cache["body"] = json.dumps(sim_state(inst)).encode()
                except (Fail, subprocess.TimeoutExpired, KeyError, ValueError):
                    cache["body"] = b"{}"
                cache["at"] = time.monotonic()
            return cache["body"]

    class Relay(http_server.BaseHTTPRequestHandler):
        def answer(self, body, kind="application/json"):
            self.send_response(200)
            self.send_header("Content-Type", kind)
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def own(self, path, body):
            asset = re.fullmatch(r"/f1emu/((?:cables/)?[\w-]+\.(js|json|png))", path)
            if asset and (SIM_DIR / asset.group(1)).is_file():
                kind = {"js": "text/javascript", "json": "application/json", "png": "image/png"}[asset.group(2)]
                self.answer((SIM_DIR / asset.group(1)).read_bytes(), kind)
            elif path == "/f1emu/state":
                self.answer(sim_json())
            elif path == "/f1emu/do" and self.command == "POST":
                try:
                    args = json.loads(body or b"{}")["args"]
                    if args[0] not in VIEW_ACTIONS or not all(re.fullmatch(r"-{0,2}[\w.]{1,32}", str(x)) for x in args):
                        raise ValueError
                except (ValueError, KeyError, IndexError, TypeError):
                    self.send_error(400)
                    return
                done = subprocess.run(me + [str(x) for x in args], capture_output=True, text=True, timeout=3700)
                with lock:
                    cache["at"] = 0.0
                said = (done.stderr or done.stdout).strip().splitlines()[-1:] or [""]
                self.answer(json.dumps({"ok": done.returncode == 0, "said": said[0]}).encode())
            else:
                self.send_error(404)

        def relay(self):
            body = self.rfile.read(int(self.headers.get("Content-Length") or 0)) or None
            path = self.path.split("?")[0]
            if path.startswith("/f1emu/"):
                try:
                    self.own(path, body)
                except OSError:
                    pass
                return
            upstream = http_client.HTTPConnection("127.0.0.1", state["guest_port"], timeout=120)
            try:
                headers = {k: v for k, v in self.headers.items() if k.lower() in ("content-type", "accept")}
                upstream.request(self.command, self.path, body, headers)
                res = upstream.getresponse()
                self.send_response(res.status)
                for name in ("Content-Type", "Cache-Control"):
                    if res.getheader(name):
                        self.send_header(name, res.getheader(name))
                if path == "/":
                    page = res.read() + b'\n<script src="f1emu/view.js"></script>\n'
                    self.send_header("Content-Length", str(len(page)))
                    self.end_headers()
                    self.wfile.write(page)
                    return
                # No length: the stream never ends, and HTTP/1.0 lets close mark the end.
                self.end_headers()
                while chunk := res.read1(65536):
                    self.wfile.write(chunk)
                    self.wfile.flush()
            except OSError:
                pass
            finally:
                upstream.close()

        do_GET = do_POST = relay

        def log_message(self, *args):
            pass

    server = http_server.ThreadingHTTPServer((state["listen"], state["port"]), Relay)
    server.daemon_threads = True
    server.timeout = 5
    while inst.running():
        server.handle_request()


def main():
