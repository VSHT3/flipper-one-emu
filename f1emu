    s.add_argument("--timeout", type=int, help=f"seconds to wait for the OS (default: {DEFAULTS['boot_timeout']})")
    s.add_argument("--print-command", action="store_true", help="print the QEMU command instead of running it")

    s = add("stop", cmd_stop, "shut the OS down cleanly")
