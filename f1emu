def cmd_start(a):
    conf = settings()
    inst = Instance(a.name)
    if inst.running():
        say(f"Instance '{inst.name}' is already running at {inst.view_url()}")
        open_view(inst, a.open or conf["open"])
        return
    need("qemu-system-aarch64", "qemu-img", "ssh-keygen")
    firmware_args()
    state = inst.state
    if state and a.build and str(a.build) != state["build"]:
        raise Fail(f"instance '{inst.name}' was created from build {state['build']}. Use `f1emu reset -n {inst.name}` "
                   f"first, or a second instance: `f1emu start -n other --build {a.build}`.")
    if state:
        build_dir = BUILDS / f"{state['build']}-{state['variant']}"
        if not (build_dir / "meta.json").exists():
            raise Fail(f"build {state['build']} was removed but instance '{inst.name}' depends on it; "
                       f"run `f1emu reset -n {inst.name}`")
        meta = json.loads((build_dir / "meta.json").read_text()) | {"dir": str(build_dir)}
    else:
        if a.build is None and a.variant is None and "build" not in conf and (have := local_builds()):
            meta = have[-1]
        else:
            meta = fetch(a.build, a.variant)
    profile = a.profile or state.get("profile") or conf["profile"]
    entry = pick_entry(meta, profile, a.kernel)
    boot = boot_files(meta, entry)
    inst.dir.mkdir(parents=True, exist_ok=True)
    root = Path(meta["dir"]) / "root.btrfs"
    grown = False
    if not inst.disk.exists():
        size = parse_size(a.disk_size) if a.disk_size else None
        if size and size < root.stat().st_size:
            raise Fail(f"--disk-size must be at least {root.stat().st_size >> 30} G")
        run(["qemu-img", "create", "-q", "-f", "qcow2", "-F", "raw", "-b", root, inst.disk] + ([str(size)] if size else []))
        grown = bool(size)
    elif a.disk_size:
        raise Fail("--disk-size only applies when the instance is created; run `f1emu reset` first")
    taken = {p for other in all_instances() if other.name != inst.name and other.running()
             for p in (other.state["port"], other.state["ssh_port"], other.state.get("guest_port"))}
    listen = a.listen or conf["listen"]
    port = free_port(listen, a.port or conf["port"], taken)
    ssh_port = free_port("127.0.0.1", a.ssh_port or conf["ssh_port"], taken | {port})
    opts = {
        "listen": listen, "port": port, "ssh_port": ssh_port,
        "guest_port": free_port("127.0.0.1", port + 10000 if port < 55000 else 18899, taken | {port, ssh_port}),
        "memory": a.memory or conf["memory"], "cpus": a.cpus or conf["cpus"],
        "append": a.append or "", "forward": a.forward, "network": not a.no_network,
        "ephemeral": a.ephemeral, "display": a.display, "qemu_arg": a.qemu_arg, "video": a.video,
    }
    inst.save(build=meta["name"], variant=meta["variant"], profile=entry["profile"], kernel=entry["version"],
              port=opts["port"], ssh_port=opts["ssh_port"], guest_port=opts["guest_port"], listen=listen,
              ephemeral=a.ephemeral)
    cmd = qemu_command(inst, meta, entry, boot, opts)
    if a.print_command:
        print(" ".join(f"'{c}'" if " " in c else c for c in cmd))
        return
    for stale in (inst.console, inst.qmp_sock, inst.pid_file):
        stale.unlink(missing_ok=True)
    say(f"Starting Flipper OS build {meta['name']}, profile {entry['profile']}, kernel {entry['version']}")
    if entry["profile"] != "Minimal":
        warn("only the Flipper panel is emulated; this profile's HDMI desktop has no screen here")
    with open(inst.qemu_log, "w") as log:
        proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
    try:
        took = wait_ready(inst, proc, a.timeout or conf["boot_timeout"])
    except KeyboardInterrupt:
        proc.terminate()
        raise Fail("interrupted; the emulator was stopped")
    if grown:
        inst.ssh("btrfs filesystem resize max /", root=True, check=False)
    say(f"Flipper OS is up after {took:.0f}s")
    notify(f"Flipper OS is up after {took:.0f}s")
    mic = a.mic or conf["mic"]
    if (conf["audio"] or mic) and not a.no_audio and opts["network"]:
        try:
            audio_on(inst, mic)
        except (Fail, subprocess.TimeoutExpired) as e:
            warn(f"no sound: {e}")
    kinds = [] if a.no_sim else sim_kinds(a.sim.split(",")) if a.sim else sim_kinds(conf["sim"]) if conf["sim"] else []
    if kinds:
        try:
            sim_on(inst, kinds)
        except (Fail, subprocess.TimeoutExpired) as e:
            warn(f"simulated hardware is not available: {e}")
    if a.video:
        try:
            video_on(inst)
        except (Fail, subprocess.TimeoutExpired) as e:
            warn(f"no video output: {e}")
    with open(inst.dir / "viewer.log", "w") as log:
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "_viewer", "-n", inst.name],
                         stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
    print(f"    Remote view : {inst.view_url()}\n    App manager : {inst.view_url('apps')}\n"
          f"    Shell       : f1emu ssh{'' if inst.name == 'default' else ' -n ' + inst.name}")
    if opts["port"] != (a.port or conf["port"]):
        warn(f"port {a.port or conf['port']} was busy, using {opts['port']}")
    open_view(inst, a.open or conf["open"])


def cmd_stop(a):
    targets = all_instances() if a.all else [Instance(a.name)]
    for inst in targets:
        pid = inst.pid()
        if inst.state:
            unmount_all(inst)
            audio_off(inst)
        if not pid:
            if not a.all:
                say(f"Instance '{inst.name}' is not running")
            continue
        if not a.force:
            say(f"Shutting down '{inst.name}'")
            try:
                inst.ssh("systemctl poweroff", root=True, timeout=15, check=False)
            except (Fail, subprocess.TimeoutExpired):
                pass
            for _ in range(60):
                if not inst.running():
                    break
                time.sleep(0.5)
        if inst.running():
            if not a.force:
                warn("the OS did not shut down by itself; stopping the emulator")
            try:
                inst.qmp("quit")
            except (OSError, Fail):
                os.kill(pid, signal.SIGTERM)
            for _ in range(20):
                if not inst.running():
                    break
                time.sleep(0.25)
        run(["pkill", "-f", f"_viewer -n {inst.name}$"], check=False)
        inst.pid_file.unlink(missing_ok=True)
        say(f"Instance '{inst.name}' stopped")


