def read_panel(inst, wait=3.0):
    """One full frame from the device's own stream: (x, y, w, h) header, then 8-bit grey."""
    canvas = bytearray(PANEL_W * PANEL_H)
    covered = False
    deadline = time.monotonic() + wait
    try:
        with urllib.request.urlopen(inst.url("stream"), timeout=wait + 5) as res:
            while not covered and time.monotonic() < deadline:
                x, y, w, h = struct.unpack("<4H", res.read(8))
                data = res.read(w * h)
                for row in range(h):
                    canvas[(y + row) * PANEL_W + x:(y + row) * PANEL_W + x + w] = data[row * w:(row + 1) * w]
                covered = w == PANEL_W and h == PANEL_H
    except (OSError, struct.error) as e:
        raise Fail(f"the device's remote view does not answer ({e})") from e
    if not covered:
        raise Fail("the device sent no full frame")
    return canvas


def write_png(path, width, height, rgb):
    def chunk(tag, data):
        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data))
    raw = b"".join(b"\0" + rgb[y * width * 3:(y + 1) * width * 3] for y in range(height))
    Path(path).write_bytes(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
                           + chunk(b"IDAT", zlib.compress(raw, 9)) + chunk(b"IEND", b""))


def video_on(inst):
    """Install the display and input drivers, which Flipper OS does not ship.

    They go onto the instance's disk so that later boots load them before the
    desktop starts. The first time, the desktop is already waiting without a
    screen and has to be restarted to notice.
    """
    if inst.ssh("test -e /dev/dri/card0", root=True, check=False).returncode == 0:
        return
    modules = sim_modules(inst)
    scp, target = inst.ssh_base("scp", root=True)
    inst.ssh("mkdir -p /lib/modules/$(uname -r)/extra", root=True)
    run(scp + [*(modules / f"{m}.ko" for m in VIDEO_MODULES), f"{target}:/lib/modules/{inst.state['kernel']}/extra/"])
    done = inst.ssh("depmod -a && modprobe virtio_dma_buf && modprobe virtio-gpu && modprobe virtio_input && "
                    "systemctl try-restart sddm 2>&1", root=True, timeout=120, check=False)
    if done.returncode:
        raise Fail(done.stdout.strip()[-400:] or "the display driver did not load")
    say("Video output is on; the desktop takes a minute or two to appear")


def cmd_screenshot(a):
    inst = Instance(a.name)
    inst.require_running()
    if a.video:
        try:
            inst.qmp("screendump", filename=os.path.abspath(a.path), device="video0", format="png")
        except Fail as e:
            raise Fail("this instance has no video output; start it with `f1emu start --video`") from e
    elif a.vt:
        with tempfile.NamedTemporaryFile(suffix=".ppm", dir=inst.dir) as tmp:
            inst.qmp("screendump", filename=tmp.name)
            m = re.match(rb"P6\s+(\d+)\s+(\d+)\s+255\s", data := Path(tmp.name).read_bytes())
            write_png(a.path, int(m.group(1)), int(m.group(2)), data[m.end():])
    else:
        grey = read_panel(inst)
        tint = (255, 255, 255) if a.grey else AMBER
        lut = [bytes(c * v // 255 for c in tint) * a.scale for v in range(256)]
        rows = (b"".join(lut[v] for v in grey[y * PANEL_W:(y + 1) * PANEL_W]) for y in range(PANEL_H))
        write_png(a.path, PANEL_W * a.scale, PANEL_H * a.scale, b"".join(row * a.scale for row in rows))
    say(f"Saved {a.path}")


def cmd_apps(a):
    inst = Instance(a.name)
    inst.require_running()
    apps = json.loads(http(inst.url("apps.json")))
    if apps.get("error"):
        warn(f"app catalogue: {apps['error']}")
    if a.action == "list":
        for app in apps["installed"]:
            print(f"installed  {app['name']}")
        for app in apps["offered"]:
            if not app["installed"]:
                print(f"available  {app['name']:28} {app['size']:>8}  {app['folder']}")
        return
    if a.action == "add":
        if not os.path.isfile(a.app):
            raise Fail(f"{a.app} is not a file")
        base, target = inst.ssh_base("scp")
        run(base + [a.app, f"{target}:Apps/"], capture_output=False)
        say(f"{os.path.basename(a.app)} copied to the device's Apps folder")
        return
    pool = apps["offered"] if a.action == "install" else apps["installed"]
    matches = [x for x in pool if x["name"].lower() == a.app.lower()] or [x for x in pool if a.app.lower() in x["name"].lower()]
    if len(matches) != 1:
        raise Fail(f"'{a.app}' matches {len(matches)} apps: {', '.join(m['name'] for m in matches) or 'none'}")
    app = matches[0]
    body = {"path": app["path"]} if a.action == "install" else {"key": app["key"]}
    answer = json.loads(http(inst.url(f"apps/{a.action}"), body, timeout=600))
    if not answer.get("ok"):
        raise Fail(f"{app['name']}: {answer.get('said', 'the device refused')}")
    say(f"{app['name']}: {answer.get('said', 'done')}")


