    s.add_argument("action", choices=("list", "save", "load", "delete"))
    s.add_argument("tag", nargs="?")

    s = add("builds", cmd_builds, "list downloaded builds, or those on the server", instance=False)
    s.add_argument("--remote", action="store_true", help="list official builds on the server")
