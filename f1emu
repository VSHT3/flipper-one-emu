    p.add_argument("--version", action="version", version=VERSION)
    sub = p.add_subparsers(dest="cmd", required=True, metavar="COMMAND")

    def add(name, fn, text, instance=True):
        sp = sub.add_parser(name, help=text, description=text)
        sp.set_defaults(fn=fn)
        if instance:
            sp.add_argument("-n", "--name", default="default", help="instance name (default: default)")
        return sp

    s = add("start", cmd_start, "boot Flipper OS (downloads the newest build on first use)")
    s.add_argument("--build", help="build number, e.g. 2494 (default: newest downloaded, else newest online)")
    s.add_argument("--variant", help=f"board image to use (default: {DEFAULTS['variant']})")
    s.add_argument("--profile", help="OS profile: Minimal, Desktop, Router, TV-Media-Box, No-Graphics")
    s.add_argument("--kernel", help="pick a kernel whose version contains this text")
    s.add_argument("-m", "--memory", type=int, help=f"guest RAM in MB (default: {DEFAULTS['memory']})")
    s.add_argument("-c", "--cpus", type=int, help=f"guest CPUs (default: {DEFAULTS['cpus']})")
    s.add_argument("-p", "--port", type=int, help=f"host port of the remote view (default: {DEFAULTS['port']})")
    s.add_argument("--ssh-port", type=int, help=f"host port of the guest's SSH (default: {DEFAULTS['ssh_port']})")
    s.add_argument("--listen", help="address the remote view binds to; 0.0.0.0 shares it on your network")
    s.add_argument("--forward", action="append", default=[], metavar="HOST:GUEST[/udp]", help="forward one more port (repeatable)")
    s.add_argument("--no-network", action="store_true", help="cut the guest off from the internet")
    s.add_argument("--no-audio", action="store_true", help="do not connect the guest's sound to this PC")
    s.add_argument("--mic", action="store_true", help="also give the guest this PC's microphone")
    s.add_argument("--sim", metavar="KINDS", help="pretend hardware to load: all, or a comma list of wifi,battery,modem")
    s.add_argument("--no-sim", action="store_true", help="ignore the `sim` setting of the config file")
